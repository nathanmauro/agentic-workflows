#!/usr/bin/env zsh
set -euo pipefail

usage() {
  cat << 'EOF'
Usage: start-claude-remote [--cwd PATH] [--model MODEL] [--label NAME] [--session NAME]
                           [--prompt TEXT] [--settings-extra JSON] [--dry-run]

Fallback launcher for explicit tmux requests and headless launchers. Starts Claude Code in a
detached tmux session with:
  --effort max
  --settings '{"ultracode":true}'
  --remote-control <label>

Options:
  --cwd PATH            Directory where Claude should start. Defaults to $PWD.
  --model MODEL         Claude model or alias. Optional; also read from CLAUDE_MODEL.
                        When unset, no --model flag is passed and the client default applies.
  --label NAME          Remote Control and Claude session display name.
  --session NAME        tmux session name. Defaults to claude-<label>-<timestamp>.
  --prompt TEXT         Initial prompt passed to Claude when the session opens.
  --settings-extra JSON JSON object merged on top of the base {"ultracode":true} settings.
                        Used by external launchers to inject per-session Stop/Notification hooks.
  --dry-run             Print the command without starting tmux; needs neither installed.
EOF
}

sanitize_name() {
  print -r -- "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9_.-]+/-/g; s/^-+//; s/-+$//'
}

cwd="$PWD"
# No default model: when unset, --model is omitted and the Claude client default applies.
model="${CLAUDE_MODEL:-}"
label=""
tmux_session=""
prompt=""
settings_extra=""
dry_run=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd)
      [[ $# -gt 1 ]] || {
        usage >&2
        exit 2
      }
      cwd="$2"
      shift 2
      ;;
    --cwd=*)
      cwd="${1#--cwd=}"
      shift
      ;;
    --model)
      [[ $# -gt 1 ]] || {
        usage >&2
        exit 2
      }
      model="$2"
      shift 2
      ;;
    --model=*)
      model="${1#--model=}"
      shift
      ;;
    --label)
      [[ $# -gt 1 ]] || {
        usage >&2
        exit 2
      }
      label="$2"
      shift 2
      ;;
    --label=*)
      label="${1#--label=}"
      shift
      ;;
    --session)
      [[ $# -gt 1 ]] || {
        usage >&2
        exit 2
      }
      tmux_session="$2"
      shift 2
      ;;
    --session=*)
      tmux_session="${1#--session=}"
      shift
      ;;
    --prompt)
      [[ $# -gt 1 ]] || {
        usage >&2
        exit 2
      }
      prompt="$2"
      shift 2
      ;;
    --prompt=*)
      prompt="${1#--prompt=}"
      shift
      ;;
    --settings-extra)
      [[ $# -gt 1 ]] || {
        usage >&2
        exit 2
      }
      settings_extra="$2"
      shift 2
      ;;
    --settings-extra=*)
      settings_extra="${1#--settings-extra=}"
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

[[ -d "$cwd" ]] || {
  print -u2 "cwd does not exist: $cwd"
  exit 1
}

if [[ -z "$label" ]]; then
  label_base="$(basename "$cwd")"
  if [[ -n "$model" ]]; then
    # Short model slug: every trailing version segment goes, so claude-example-4-5 is example.
    model_slug="$(print -r -- "$model" | sed -E 's/^claude-//; s/(-[0-9.]+)+$//')"
    label_base+="-${model_slug}"
  fi
  label="$(sanitize_name "${label_base}-ultra")"
else
  label="$(sanitize_name "$label")"
fi
[[ -n "$label" ]] || {
  print -u2 "label is empty after sanitization"
  exit 1
}

if [[ -z "$tmux_session" ]]; then
  tmux_session="claude-${label}-$(date +%Y%m%d%H%M%S)"
else
  tmux_session="$(sanitize_name "$tmux_session")"
fi
[[ -n "$tmux_session" ]] || {
  print -u2 "tmux session is empty after sanitization"
  exit 1
}

# --dry-run only prints, so it works on a host without claude or tmux installed.
claude_bin="$(command -v claude || true)"
if [[ -z "$claude_bin" ]]; then
  [[ "$dry_run" -eq 1 ]] || {
    print -u2 "claude not found"
    exit 1
  }
  claude_bin="claude"
fi

settings='{"ultracode":true}'
if [[ -n "$settings_extra" ]]; then
  # Launchers inject their Stop/Notification hooks here, so a bad merge must fail the launch
  # rather than start a session whose completion hook never fires.
  merged="$(python3 -c "
import json, sys
base = json.loads(sys.argv[1])
try:
    extra = json.loads(sys.argv[2])
except ValueError as err:
    sys.exit(f'--settings-extra is not valid JSON: {err}')
if not isinstance(extra, dict):
    sys.exit('--settings-extra must be a JSON object')
for k, v in extra.items():
    if k == 'hooks' and isinstance(v, dict) and isinstance(base.get('hooks'), dict):
        for hk, hv in v.items():
            base['hooks'][hk] = hv
    else:
        base[k] = v
print(json.dumps(base, separators=(',', ':')))
" "$settings" "$settings_extra")" || {
    print -u2 "start-claude-remote: could not merge --settings-extra"
    exit 2
  }
  settings="$merged"
fi

# An argv array, not a shell string: tmux execs it directly, so the prompt never depends on
# the default-shell's quoting rules.
claude_argv=("$claude_bin")
if [[ -n "$model" ]]; then
  claude_argv+=(--model "$model")
fi
claude_argv+=(--effort max)
claude_argv+=(--settings "$settings")
claude_argv+=(--remote-control "$label")
claude_argv+=(--name "$label")
if [[ -n "$prompt" ]]; then
  # The separator keeps a prompt that starts with '-' from parsing as an option.
  claude_argv+=(-- "$prompt")
fi

if [[ "$dry_run" -eq 1 ]]; then
  print -r -- "${(j: :)${(q)claude_argv[@]}}"
  exit 0
fi

command -v tmux > /dev/null || {
  print -u2 "tmux not found"
  exit 1
}

if tmux has-session -t "$tmux_session" 2> /dev/null; then
  print -u2 "tmux session already exists: $tmux_session"
  exit 1
fi

tmux new-session -d -s "$tmux_session" -c "$cwd" -- "${claude_argv[@]}"
sleep 2

plain_capture="$(tmux capture-pane -pt "$tmux_session" -S -200 2> /dev/null || true)"
raw_capture="$(tmux capture-pane -ept "$tmux_session" -S -200 2> /dev/null || true)"
remote_url_re='https://claude\.ai/code/[A-Za-z0-9_/-]+'
remote_url="$(
  print -r -- "$raw_capture" \
    | LC_ALL=C grep -Eo "$remote_url_re" \
    | tail -1 \
    || true
)"

print -r -- "tmux session: $tmux_session"
print -r -- "attach: tmux attach -t $tmux_session"
if [[ -n "$remote_url" ]]; then
  print -r -- "remote: $remote_url"
else
  print -r -- "remote: not visible yet; attach or capture the pane after Claude connects"
fi

print -r -- ""
status_re='max effort|Remote Control|setup issue|model:'
print -r -- "$plain_capture" | grep -E "$status_re" | tail -8 || true
